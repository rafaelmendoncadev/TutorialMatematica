@model TutorialMatematica.Models.Exam
@{
    ViewData["Title"] = "Simulado Oficial - 10 Questões";
}

<!-- Golden Rule Alert Banner -->
<div class="mb-4 sm:mb-6 bg-gradient-to-r from-indigo-50 via-purple-50 to-indigo-50 border border-indigo-200 rounded-2xl p-3 sm:p-4 text-xs text-primary shadow-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2.5 sm:gap-3">
    <div class="flex items-start sm:items-center gap-2.5 sm:gap-3">
        <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-primary text-white flex items-center justify-center shrink-0 mt-0.5 sm:mt-0">
            <span class="material-symbols-outlined text-[16px] sm:text-[18px]">verified_user</span>
        </div>
        <div>
            <span class="font-extrabold text-slate-900 block text-[11px] sm:text-xs">Regra de Ouro da Certificação:</span>
            <span class="text-slate-600 text-[10px] sm:text-[11px] leading-tight block">
                Acerto necessário: <strong>10 de 10 questões (100%)</strong>. O gabarito analítico e o Tutor IA serão desbloqueados na conclusão.
            </span>
        </div>
    </div>
    <div class="flex items-center gap-2 self-end sm:self-auto shrink-0">
        <a asp-controller="Home" asp-action="Index" class="px-2.5 py-1 rounded-lg border border-indigo-200 text-slate-600 hover:text-primary hover:bg-white transition-colors text-[11px] font-semibold">
            Sair do Exame
        </a>
    </div>
</div>

<form id="examForm" method="post" asp-action="ConcluirSimulado">
    <input type="hidden" name="tempoSegundos" id="tempoSegundosInput" value="0" />

    <!-- MOBILE STICKY STATUS & QUICK NAV (Visible on mobile/tablet) -->
    <div class="lg:hidden sticky top-14 sm:top-16 z-40 bg-white/95 backdrop-blur-md border border-indigo-100 rounded-2xl p-3 mb-4 shadow-sm space-y-2.5">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span id="mobileActiveQBadge" class="bg-primary text-white text-[11px] font-mono font-bold px-2 py-0.5 rounded-lg">
                    Q01
                </span>
                <span id="mobileAnsweredCount" class="text-xs font-bold text-slate-700">0 de 10 respondidas</span>
            </div>

            <div class="flex items-center gap-1.5 text-rose-600 font-mono text-xs font-bold bg-rose-50 px-2.5 py-0.5 rounded-full border border-rose-100">
                <span class="w-1.5 h-1.5 rounded-full bg-rose-600 animate-pulse"></span>
                <span id="mobileTimerDisplay">00:00</span>
            </div>
        </div>

        <!-- Quick 10-Question Horizontal Rail on Mobile -->
        <div class="flex gap-1.5 overflow-x-auto no-scrollbar pb-0.5">
            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                var q = Model.Questions[i];
                <button type="button"
                        onclick="goToQuestion(@q.Number)"
                        id="mobileNavBtn_@q.Number"
                        class="min-w-[36px] h-9 rounded-xl text-xs font-mono font-bold flex items-center justify-center transition-all border shrink-0 @(i == 0 ? "bg-primary text-white border-primary shadow-xs" : "bg-[#FAF8FF] border-indigo-100 text-slate-600")">
                    @q.Number.ToString("D2")
                </button>
            }
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-4 sm:gap-6">

        <!-- LEFT COLUMN: Desktop Exam Map & Helper (Hidden on mobile to save vertical scroll) -->
        <div class="hidden lg:block space-y-6">

            <!-- Timer & Quick Progress Box -->
            <div class="bg-white border border-indigo-100 rounded-3xl p-5 shadow-xs space-y-4">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Cronômetro</span>
                    <span class="flex items-center gap-1.5 text-rose-600 font-mono text-xs font-bold bg-rose-50 px-2.5 py-1 rounded-full border border-rose-100">
                        <span class="w-2 h-2 rounded-full bg-rose-600 animate-pulse"></span>
                        <span id="timerDisplay">00:00</span>
                    </span>
                </div>

                <div class="space-y-2">
                    <div class="flex justify-between items-center text-xs">
                        <span class="font-bold text-slate-700">Progresso</span>
                        <span id="answeredCountLabel" class="font-mono text-primary font-bold">0 de @Model.Questions.Count</span>
                    </div>
                    <div class="w-full bg-indigo-50 h-2.5 rounded-full overflow-hidden border border-indigo-100">
                        <div id="examProgressBar" class="bg-gradient-to-r from-primary to-secondary h-full rounded-full transition-all duration-300" style="width: 0%"></div>
                    </div>
                </div>
            </div>

            <!-- Exam Map Card -->
            <div class="bg-white border border-indigo-100 rounded-3xl p-5 shadow-xs space-y-4">
                <div class="flex items-center justify-between">
                    <h3 class="font-extrabold text-sm text-slate-900">Mapa de Questões</h3>
                    <span class="text-[10px] font-mono font-bold text-slate-400">10 ITENS</span>
                </div>

                <!-- 10 Question Buttons -->
                <div class="grid grid-cols-5 gap-2">
                    @for (int i = 0; i < Model.Questions.Count; i++)
                    {
                        var q = Model.Questions[i];
                        <button type="button"
                                onclick="goToQuestion(@q.Number)"
                                id="navBtn_@q.Number"
                                class="h-11 rounded-xl text-xs font-mono font-extrabold flex flex-col items-center justify-center transition-all border @(i == 0 ? "bg-primary text-white border-primary shadow-sm ring-2 ring-primary ring-offset-2" : "bg-[#FAF8FF] border-indigo-100 text-slate-600 hover:bg-indigo-50")">
                            <span>@q.Number.ToString("D2")</span>
                            <span id="statusIcon_@q.Number" class="text-[9px] -mt-0.5">○</span>
                        </button>
                    }
                </div>

                <!-- Legend -->
                <div class="space-y-2 text-[11px] text-slate-500 pt-3 border-t border-slate-100">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-primary ring-2 ring-primary/20"></span>
                        <span class="font-medium text-slate-700">Questão atual</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
                        <span>Respondida</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                        <span>Marcada para revisão</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-indigo-100 border border-indigo-200"></span>
                        <span>Não respondida</span>
                    </div>
                </div>
            </div>

            <!-- Formula Helper Card -->
            <div class="bg-gradient-to-br from-[#FAF8FF] to-indigo-50/50 border border-indigo-100 rounded-3xl p-5 shadow-xs space-y-3">
                <div class="flex items-center gap-1.5 text-xs font-bold text-primary">
                    <span class="material-symbols-outlined text-[18px]">calculate</span>
                    <span>Lembretes Rápidos</span>
                </div>
                <div class="font-mono-math text-xs text-slate-600 space-y-2 leading-relaxed">
                    <div class="p-2 bg-white rounded-xl border border-indigo-100/80 shadow-2xs">
                        <span class="text-[10px] text-slate-400 block font-sans">Círculo e Perímetro</span>
                        <strong class="text-primary">C = 2·π·r &bull; A = π·r²</strong>
                        <span class="text-[10px] text-slate-500 block">π ≈ 3,14</span>
                    </div>
                    <div class="p-2 bg-white rounded-xl border border-indigo-100/80 shadow-2xs">
                        <span class="text-[10px] text-slate-400 block font-sans">Pitágoras & Trapézio</span>
                        <strong class="text-primary">c² = a² + b²</strong>
                        <span class="text-[10px] text-slate-500 block">A = [(B+b)·h]/2</span>
                    </div>
                </div>
            </div>

        </div>

        <!-- RIGHT COLUMN: Active Question Display -->
        <div class="lg:col-span-3 space-y-4 sm:space-y-6">

            @foreach (var q in Model.Questions)
            {
                <div id="questionContainer_@q.Number" class="question-container @(q.Number == 1 ? "" : "hidden") space-y-4 sm:space-y-6">

                    <!-- Question Card -->
                    <div class="bg-white border border-indigo-100 rounded-2xl sm:rounded-3xl p-4 sm:p-6 lg:p-8 shadow-xs space-y-4 sm:space-y-6">

                        <!-- Question Top Metadata -->
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 sm:pb-4 border-b border-slate-100 gap-2.5 sm:gap-3">
                            <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
                                <span class="bg-indigo-50 text-primary text-[11px] sm:text-xs font-extrabold px-2.5 py-0.5 sm:py-1 rounded-xl border border-indigo-100 font-mono">
                                    Questão @q.Number.ToString("D2") de @Model.Questions.Count
                                </span>
                                <span class="text-[10px] sm:text-xs text-slate-500 font-bold uppercase tracking-wider">
                                    @q.Topic &bull; @q.SubTopic
                                </span>
                            </div>

                            <button type="button"
                                    onclick="toggleFlagQuestion(@q.Number)"
                                    id="flagBtn_@q.Number"
                                    class="text-xs text-slate-500 hover:text-amber-600 flex items-center gap-1 border border-slate-200 px-3 py-1.5 rounded-xl transition-colors self-start sm:self-auto">
                                <span class="material-symbols-outlined text-[16px]">bookmark_border</span>
                                <span id="flagText_@q.Number">Revisar</span>
                            </button>
                        </div>

                        <!-- Problem Statement -->
                        <div class="space-y-2 sm:space-y-3 text-slate-800 text-xs sm:text-sm lg:text-base leading-relaxed">
                            <p class="font-medium">
                                @q.Statement
                            </p>
                        </div>

                        <!-- Technical Parameter & SVG Box -->
                        <div class="bg-[#FAF8FF] border border-indigo-100 rounded-xl sm:rounded-2xl p-3.5 sm:p-5 flex flex-col md:flex-row items-center justify-between gap-4 sm:gap-6">
                            <div class="space-y-1.5 sm:space-y-2 max-w-sm w-full">
                                <span class="text-[9px] sm:text-[10px] font-mono font-bold text-primary bg-indigo-50 px-2 py-0.5 rounded-full border border-indigo-100">
                                    @q.TechnicalBadge
                                </span>
                                <h4 class="font-bold text-xs sm:text-sm text-slate-900">@q.TechnicalTitle</h4>
                                <p class="text-[11px] sm:text-xs text-slate-500 leading-relaxed">
                                    @q.TechnicalDescription
                                </p>
                                <div class="bg-white p-2 sm:p-2.5 rounded-xl border border-indigo-100 font-mono-math text-[11px] sm:text-xs text-primary shadow-2xs">
                                    @q.ParameterSummary
                                </div>
                            </div>

                            <!-- SVG Diagram Container -->
                            <div class="w-full max-w-xs sm:max-w-sm h-40 sm:h-48 bg-white p-2 rounded-xl sm:rounded-2xl border border-indigo-100 shadow-2xs flex items-center justify-center overflow-hidden mx-auto md:mx-0">
                                @Html.Raw(q.DiagramSvg)
                            </div>
                        </div>

                        <!-- Multiple Choice Options -->
                        <div class="space-y-2.5 sm:space-y-3">
                            <div class="text-[11px] sm:text-xs font-bold text-slate-500 uppercase tracking-wider flex items-center gap-1">
                                <span class="material-symbols-outlined text-[16px]">radio_button_checked</span>
                                Selecione uma alternativa:
                            </div>

                            <div class="space-y-2">
                                @foreach (var opt in q.Options)
                                {
                                    <label id="label_@(q.Number)_@(opt.Key)"
                                           onclick="selectOption(@q.Number, '@opt.Key')"
                                           class="option-label-@(q.Number) flex items-center justify-between p-3 sm:p-4 rounded-xl sm:rounded-2xl border border-indigo-100 hover:border-indigo-300 hover:bg-indigo-50/40 cursor-pointer transition-all active:scale-[0.99]">
                                        <div class="flex items-center gap-2.5 sm:gap-3">
                                            <input type="radio"
                                                   name="respostas[@q.Number]"
                                                   value="@opt.Key"
                                                   id="radio_@(q.Number)_@(opt.Key)"
                                                   class="w-4 h-4 text-primary focus:ring-primary border-slate-300" />
                                            <span class="w-6 h-6 sm:w-7 sm:h-7 rounded-xl bg-indigo-50 text-primary text-xs font-extrabold flex items-center justify-center font-mono border border-indigo-100 shrink-0">
                                                @opt.Key
                                            </span>
                                            <span class="font-mono-math text-xs sm:text-sm text-slate-800 font-medium">
                                                @opt.Text
                                            </span>
                                        </div>
                                        <span id="badge_@(q.Number)_@(opt.Key)" class="hidden text-[9px] sm:text-[10px] font-bold text-primary bg-indigo-100 px-2 py-0.5 rounded-full font-sans">
                                            Marcada
                                        </span>
                                    </label>
                                }
                            </div>
                        </div>

                        <!-- Tutor Hint Callout -->
                        <div class="bg-purple-50/70 border border-purple-100 rounded-xl sm:rounded-2xl p-3 sm:p-4 flex items-start gap-2.5 sm:gap-3">
                            <span class="material-symbols-outlined text-tutor-purple text-lg sm:text-xl shrink-0 mt-0.5">lightbulb</span>
                            <div class="text-[11px] sm:text-xs text-slate-600 leading-relaxed">
                                <strong class="text-tutor-purple">Dica do Tutor IA:</strong> @q.TutorHint
                            </div>
                        </div>

                    </div>

                    <!-- Action Navigation Bar (Mobile Ergonomic Layout) -->
                    <div class="bg-white border border-indigo-100 rounded-2xl sm:rounded-3xl p-3 sm:p-4 shadow-xs flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2.5 sm:gap-4">
                        <div class="flex items-center gap-2 w-full sm:w-auto">
                            <button type="button"
                                    onclick="goToPreviousQuestion(@q.Number)"
                                    class="flex-1 sm:flex-none text-xs font-bold text-slate-600 hover:text-slate-900 px-3.5 py-2.5 sm:py-3 rounded-xl border border-slate-200 hover:bg-slate-50 transition-colors flex items-center justify-center gap-1 @(q.Number == 1 ? "opacity-40 cursor-not-allowed" : "")">
                                <span class="material-symbols-outlined text-[16px]">arrow_back</span>
                                <span>Anterior</span>
                            </button>

                            @if (q.Number < Model.Questions.Count)
                            {
                                <button type="button"
                                        onclick="goToNextQuestion(@q.Number)"
                                        class="flex-1 sm:flex-none bg-indigo-50 hover:bg-indigo-100 text-primary text-xs font-bold px-4 py-2.5 sm:py-3 rounded-xl transition flex items-center justify-center gap-1 border border-indigo-200">
                                    <span>Próxima</span>
                                    <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                                </button>
                            }
                        </div>

                        <button type="button"
                                onclick="confirmSubmission()"
                                class="w-full sm:w-auto bg-primary hover:bg-primary-dark text-white text-xs sm:text-sm font-bold px-6 py-2.5 sm:py-3 rounded-xl shadow-md shadow-primary/20 transition flex items-center justify-center gap-2 active:scale-[0.98]">
                            <span class="material-symbols-outlined text-[18px]">done_all</span>
                            <span>Concluir Simulado</span>
                        </button>
                    </div>

                </div>
            }

        </div>

    </div>
</form>

@section Scripts {
<script>
    let currentQuestion = 1;
    const totalQuestions = @Model.Questions.Count;
    let elapsedSeconds = 0;
    const flaggedQuestions = new Set();
    const answeredMap = {};

    // Timer Interval
    setInterval(() => {
        elapsedSeconds++;
        document.getElementById('tempoSegundosInput').value = elapsedSeconds;
        const mins = Math.floor(elapsedSeconds / 60).toString().padStart(2, '0');
        const secs = (elapsedSeconds % 60).toString().padStart(2, '0');
        const timeStr = `${mins}:${secs}`;
        
        const desktopTimer = document.getElementById('timerDisplay');
        if (desktopTimer) desktopTimer.innerText = timeStr;

        const mobileTimer = document.getElementById('mobileTimerDisplay');
        if (mobileTimer) mobileTimer.innerText = timeStr;
    }, 1000);

    function goToQuestion(qNum) {
        if (qNum < 1 || qNum > totalQuestions) return;
        
        // Hide all
        document.querySelectorAll('.question-container').forEach(el => el.classList.add('hidden'));
        
        // Show selected
        const target = document.getElementById(`questionContainer_${qNum}`);
        if (target) {
            target.classList.remove('hidden');
            currentQuestion = qNum;
            updateMapStyles();
            
            // Scroll to top of question on mobile
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    }

    function goToNextQuestion(qNum) {
        goToQuestion(qNum + 1);
    }

    function goToPreviousQuestion(qNum) {
        goToQuestion(qNum - 1);
    }

    function selectOption(qNum, key) {
        answeredMap[qNum] = key;
        const radio = document.getElementById(`radio_${qNum}_${key}`);
        if (radio) radio.checked = true;

        // Reset styling for options in this question
        document.querySelectorAll(`.option-label-${qNum}`).forEach(lbl => {
            lbl.classList.remove('border-2', 'border-primary', 'bg-indigo-50/60');
            lbl.classList.add('border-indigo-100');
        });

        // Hide all badges for this question
        document.querySelectorAll(`[id^="badge_${qNum}_"]`).forEach(b => b.classList.add('hidden'));

        // Apply active to selected
        const selectedLabel = document.getElementById(`label_${qNum}_${key}`);
        if (selectedLabel) {
            selectedLabel.classList.remove('border-indigo-100');
            selectedLabel.classList.add('border-2', 'border-primary', 'bg-indigo-50/60');
        }

        const selectedBadge = document.getElementById(`badge_${qNum}_${key}`);
        if (selectedBadge) {
            selectedBadge.classList.remove('hidden');
        }

        updateMapStyles();
        updateProgress();
    }

    function toggleFlagQuestion(qNum) {
        const flagBtn = document.getElementById(`flagBtn_${qNum}`);
        const flagText = document.getElementById(`flagText_${qNum}`);
        
        if (flaggedQuestions.has(qNum)) {
            flaggedQuestions.delete(qNum);
            if (flagBtn) {
                flagBtn.classList.remove('text-amber-700', 'bg-amber-50', 'border-amber-300');
                flagBtn.classList.add('text-slate-500', 'border-slate-200');
            }
            if (flagText) flagText.innerText = "Revisar";
        } else {
            flaggedQuestions.add(qNum);
            if (flagBtn) {
                flagBtn.classList.remove('text-slate-500', 'border-slate-200');
                flagBtn.classList.add('text-amber-700', 'bg-amber-50', 'border-amber-300');
            }
            if (flagText) flagText.innerText = "Marcada";
        }
        updateMapStyles();
    }

    function updateMapStyles() {
        // Mobile header badge
        const mobileBadge = document.getElementById('mobileActiveQBadge');
        if (mobileBadge) mobileBadge.innerText = `Q${currentQuestion.toString().padStart(2, '0')}`;

        for (let i = 1; i <= totalQuestions; i++) {
            const btn = document.getElementById(`navBtn_${i}`);
            const mobileBtn = document.getElementById(`mobileNavBtn_${i}`);
            const icon = document.getElementById(`statusIcon_${i}`);

            const isCurrent = (i === currentQuestion);
            const isAnswered = answeredMap[i] !== undefined;
            const isFlagged = flaggedQuestions.has(i);

            // Desktop Buttons
            if (btn && icon) {
                btn.className = "h-11 rounded-xl text-xs font-mono font-extrabold flex flex-col items-center justify-center transition-all border";

                if (isCurrent) {
                    btn.classList.add('bg-primary', 'text-white', 'border-primary', 'ring-2', 'ring-primary', 'ring-offset-2', 'shadow-sm');
                    icon.innerText = isAnswered ? "✓" : "●";
                } else if (isFlagged) {
                    btn.classList.add('bg-amber-50', 'border-amber-300', 'text-amber-800');
                    icon.innerText = "⚠️";
                } else if (isAnswered) {
                    btn.classList.add('bg-emerald-50', 'border-emerald-300', 'text-emerald-700');
                    icon.innerText = "✓";
                } else {
                    btn.classList.add('bg-[#FAF8FF]', 'border-indigo-100', 'text-slate-600', 'hover:bg-indigo-50');
                    icon.innerText = "○";
                }
            }

            // Mobile Buttons
            if (mobileBtn) {
                mobileBtn.className = "min-w-[36px] h-9 rounded-xl text-xs font-mono font-bold flex items-center justify-center transition-all border shrink-0";

                if (isCurrent) {
                    mobileBtn.classList.add('bg-primary', 'text-white', 'border-primary', 'shadow-xs');
                } else if (isFlagged) {
                    mobileBtn.classList.add('bg-amber-50', 'border-amber-300', 'text-amber-800');
                } else if (isAnswered) {
                    mobileBtn.classList.add('bg-emerald-50', 'border-emerald-300', 'text-emerald-700');
                } else {
                    mobileBtn.classList.add('bg-[#FAF8FF]', 'border-indigo-100', 'text-slate-600');
                }
            }
        }
    }

    function updateProgress() {
        const answeredCount = Object.keys(answeredMap).length;
        const pct = Math.round((answeredCount / totalQuestions) * 100);

        const desktopCount = document.getElementById('answeredCountLabel');
        if (desktopCount) desktopCount.innerText = `${answeredCount} de ${totalQuestions}`;

        const mobileCount = document.getElementById('mobileAnsweredCount');
        if (mobileCount) mobileCount.innerText = `${answeredCount} de ${totalQuestions} respondidas`;

        const progressBar = document.getElementById('examProgressBar');
        if (progressBar) progressBar.style.width = `${pct}%`;
    }

    function confirmSubmission() {
        const answeredCount = Object.keys(answeredMap).length;
        const unansweredCount = totalQuestions - answeredCount;

        if (unansweredCount > 0) {
            const confirmMsg = `Atenção: você ainda possui ${unansweredCount} questão(ões) não respondida(s).\nLembre-se: para certificação é necessário obter 100% (10/10).\n\nDeseja realmente concluir e corrigir o simulado agora?`;
            if (!confirm(confirmMsg)) {
                return;
            }
        } else {
            if (!confirm("Todas as 10 questões foram respondidas! Deseja concluir e ver o gabarito final?")) {
                return;
            }
        }

        document.getElementById('examForm').submit();
    }
</script>
}
