@model TutorialMatematica.Models.StudentProfile
@{
    ViewData["Title"] = "Dashboard & Trilha de Aprendizagem";
    var lastAttempt = Model.RecentAttempts.FirstOrDefault();
}

<div class="space-y-6 sm:space-y-8">
    
    <!-- Welcome Banner -->
    <div class="bg-white border border-indigo-100 rounded-2xl sm:rounded-3xl p-4 sm:p-6 lg:p-8 shadow-xs hover:shadow-sm transition-shadow flex flex-col lg:flex-row items-start lg:items-center justify-between gap-5 sm:gap-6">
        <div class="space-y-2.5 sm:space-y-3 max-w-2xl w-full">
            <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
                <span class="bg-indigo-50 text-primary text-[10px] sm:text-xs font-mono font-bold px-2.5 py-0.5 sm:py-1 rounded-full border border-indigo-100 flex items-center gap-1 sm:gap-1.5">
                    <span class="material-symbols-outlined text-[14px] sm:text-[16px] text-secondary">verified</span>
                    TRILHA OFICIAL &bull; GEOMETRIA EUCLIDIANA
                </span>
                <span class="text-[11px] sm:text-xs text-slate-500 font-medium">Nível: @Model.Level</span>
            </div>
            
            <h1 class="font-extrabold text-xl sm:text-2xl lg:text-3xl text-slate-900 tracking-tight leading-tight">
                Olá, @Model.Name! Pronto para dominar a Geometria?
            </h1>
            
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                <strong class="text-primary font-semibold">Meta de Certificação:</strong> @Model.ActiveGoal
            </p>
        </div>

        <!-- Progress Widget -->
        <div class="bg-gradient-to-br from-[#FAF8FF] to-indigo-50/50 border border-indigo-100/80 rounded-xl sm:rounded-2xl p-4 sm:p-5 w-full lg:w-72 shrink-0 space-y-2.5 sm:space-y-3 shadow-inner">
            <div class="flex justify-between items-center text-xs font-bold">
                <span class="text-slate-600 uppercase tracking-wider text-[10px] sm:text-[11px]">Progresso da Trilha</span>
                <span class="text-primary font-mono text-sm sm:text-base">@Model.OverallProgress%</span>
            </div>
            <div class="w-full bg-indigo-100/70 h-2.5 sm:h-3 rounded-full overflow-hidden p-0.5">
                <div class="bg-gradient-to-r from-primary to-secondary h-full rounded-full transition-all duration-700" style="width: @Model.OverallProgress%"></div>
            </div>
            <div class="flex justify-between items-center text-[10px] sm:text-[11px] text-slate-500 font-medium">
                <span>⚡ @Model.TotalXp XP</span>
                <span class="text-emerald-600 font-semibold flex items-center gap-0.5">
                    <span class="material-symbols-outlined text-[14px]">military_tech</span>
                    @(Model.OverallProgress == 100 ? "Certificado Ativo" : "Certificado Próximo")
                </span>
            </div>
        </div>
    </div>

    <!-- Main Grid: Modules & Quick Exam (Left 2/3) + Tutor & Formulas (Right 1/3) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8">
        
        <!-- Left Column: Study Modules & Simulado Card -->
        <div class="lg:col-span-2 space-y-6 sm:space-y-8">
            
            <!-- Section Header -->
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="font-extrabold text-lg sm:text-xl text-slate-900 flex items-center gap-2">
                        <span class="material-symbols-outlined text-secondary text-xl sm:text-2xl">explore</span>
                        Módulos da Trilha
                    </h2>
                    <p class="text-[11px] sm:text-xs text-slate-500 mt-0.5">Deduções geométricas, conversão de grandezas e testes interativos.</p>
                </div>
                <a asp-controller="Home" asp-action="Aulas" class="text-xs font-bold text-secondary hover:text-primary transition-colors flex items-center gap-1 shrink-0">
                    <span class="hidden sm:inline">Ver todas as aulas</span>
                    <span class="sm:hidden">Ver tudo</span>
                    <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                </a>
            </div>

            <!-- Modules List Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 sm:gap-4">
                @foreach (var mod in Model.Modules)
                {
                    var isCompleted = mod.Percentage == 100;
                    var isCurrent = mod.IsCurrent;
                    
                    <div class="bg-white border rounded-2xl p-4 sm:p-5 shadow-xs hover:shadow-md transition-all flex flex-col justify-between space-y-3.5 sm:space-y-4 @(isCurrent ? "border-2 border-secondary shadow-indigo-100/50 relative" : "border-indigo-100/80")">
                        @if (isCurrent)
                        {
                            <span class="absolute -top-2.5 right-4 bg-secondary text-white text-[9px] sm:text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider shadow-xs">
                                Em Curso
                            </span>
                        }
                        
                        <div class="space-y-2.5 sm:space-y-3">
                            <div class="flex items-center justify-between">
                                <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl @(isCompleted ? "bg-emerald-50 text-emerald-600 border border-emerald-100" : isCurrent ? "bg-indigo-50 text-secondary border border-indigo-100" : "bg-slate-100 text-slate-400") flex items-center justify-center font-bold">
                                    <span class="material-symbols-outlined text-lg sm:text-xl">@mod.Icon</span>
                                </div>
                                <span class="text-[10px] sm:text-[11px] font-bold px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-full @(isCompleted ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : isCurrent ? "bg-indigo-50 text-secondary border border-indigo-200" : "bg-slate-100 text-slate-500")">
                                    @(isCompleted ? "100% Concluído" : isCurrent ? $"{mod.Percentage}% em andamento" : "Bloqueado")
                                </span>
                            </div>

                            <div>
                                <h3 class="font-bold text-sm sm:text-base text-slate-900 leading-snug">@mod.Title</h3>
                                <p class="text-xs text-slate-500 mt-1 leading-relaxed line-clamp-2">@mod.Description</p>
                            </div>

                            <div class="bg-[#FAF8FF] p-2 sm:p-2.5 rounded-xl font-mono-math text-[11px] sm:text-xs text-primary border border-indigo-100/60 overflow-x-auto no-scrollbar whitespace-nowrap">
                                @mod.FormulaPreview
                            </div>
                        </div>

                        <div class="flex items-center justify-between pt-2 border-t border-slate-100 text-xs">
                            <span class="text-slate-500 text-[10px] sm:text-[11px]">⏱️ @mod.EstimatedTime</span>
                            <a asp-controller="Home" asp-action="Aulas" class="font-bold @(isCompleted ? "text-slate-600 hover:text-primary" : "text-secondary hover:text-primary") inline-flex items-center gap-1 transition-colors py-1">
                                @(isCompleted ? "Revisar" : isCurrent ? "Continuar" : "Detalhes")
                                <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                            </a>
                        </div>
                    </div>
                }
            </div>

            <!-- SIMULADO 10/10 CARD -->
            <div class="bg-gradient-to-br from-white to-indigo-50/40 border border-indigo-200 rounded-2xl sm:rounded-3xl p-4 sm:p-6 lg:p-7 shadow-xs space-y-4 sm:space-y-5">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl sm:rounded-2xl bg-primary text-white flex items-center justify-center shadow-md shadow-primary/20 shrink-0">
                            <span class="material-symbols-outlined text-xl sm:text-2xl">fact_check</span>
                        </div>
                        <div>
                            <h3 class="font-extrabold text-base sm:text-lg text-slate-900">Simulado Oficial (10 Questões)</h3>
                            <p class="text-[11px] sm:text-xs text-slate-500">Avaliação integral de geometria com geração procedural</p>
                        </div>
                    </div>
                    <span class="text-[10px] sm:text-xs font-mono font-bold px-2.5 py-1 bg-amber-100 text-amber-800 rounded-full border border-amber-200 self-start sm:self-auto">
                        🎯 EXIGE 10/10 PARA CERTIFICAÇÃO
                    </span>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-3 text-center">
                    <div class="bg-white p-2.5 sm:p-3.5 rounded-xl sm:rounded-2xl border border-indigo-100 shadow-2xs">
                        <div class="text-[10px] sm:text-[11px] font-semibold text-slate-500 uppercase tracking-wider">Última Nota</div>
                        <div class="text-sm sm:text-base lg:text-lg font-extrabold font-mono text-primary mt-0.5 sm:mt-1">
                            @(lastAttempt != null ? $"{lastAttempt.CorrectCount}/10 ({lastAttempt.ScorePercentage}%)" : "--")
                        </div>
                    </div>
                    <div class="bg-white p-2.5 sm:p-3.5 rounded-xl sm:rounded-2xl border border-indigo-100 shadow-2xs">
                        <div class="text-[10px] sm:text-[11px] font-semibold text-slate-500 uppercase tracking-wider">Tempo</div>
                        <div class="text-sm sm:text-base lg:text-lg font-extrabold font-mono text-slate-800 mt-0.5 sm:mt-1">
                            @(lastAttempt != null ? lastAttempt.ElapsedFormatted : "--")
                        </div>
                    </div>
                    <div class="bg-white p-2.5 sm:p-3.5 rounded-xl sm:rounded-2xl border border-indigo-100 shadow-2xs">
                        <div class="text-[10px] sm:text-[11px] font-semibold text-slate-500 uppercase tracking-wider">Erros</div>
                        <div class="text-sm sm:text-base lg:text-lg font-extrabold font-mono text-rose-600 mt-0.5 sm:mt-1">
                            @(lastAttempt != null ? $"{lastAttempt.IncorrectCount} Qs" : "0")
                        </div>
                    </div>
                    <div class="bg-white p-2.5 sm:p-3.5 rounded-xl sm:rounded-2xl border border-indigo-100 shadow-2xs">
                        <div class="text-[10px] sm:text-[11px] font-semibold text-slate-500 uppercase tracking-wider">Meta Selo</div>
                        <div class="text-sm sm:text-base lg:text-lg font-extrabold font-mono text-emerald-600 mt-0.5 sm:mt-1">
                            100% (10/10)
                        </div>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 sm:gap-4 pt-1 sm:pt-2">
                    <div class="flex items-center gap-1.5 text-[11px] sm:text-xs text-slate-500">
                        <span class="material-symbols-outlined text-[16px] sm:text-[18px] text-primary">timer</span>
                        <span>Cronômetro &bull; Tutor IA &bull; SVG interativo</span>
                    </div>
                    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 sm:gap-3 w-full sm:w-auto">
                        @if (lastAttempt != null)
                        {
                            <a asp-controller="Home" asp-action="Gabarito" class="text-center px-4 py-2.5 sm:py-3 rounded-xl border border-indigo-200 text-xs font-bold text-slate-700 bg-white hover:bg-slate-50 transition-colors">
                                Ver Gabarito
                            </a>
                        }
                        <a asp-controller="Home" asp-action="Simulado" class="text-center px-5 py-3 rounded-xl bg-primary hover:bg-primary-dark text-white text-xs sm:text-sm font-bold shadow-md shadow-primary/20 hover:scale-[1.01] active:scale-[0.98] transition-all flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined text-[18px]">play_arrow</span>
                            <span>Iniciar Simulado</span>
                        </a>
                    </div>
                </div>
            </div>

        </div>

        <!-- Right Column: AI Tutor Card & Rapid Formula Reference -->
        <div class="space-y-4 sm:space-y-6">
            
            <!-- AI Tutor Interactive Callout -->
            <div class="bg-gradient-to-br from-purple-50 via-white to-indigo-50 border border-purple-200/80 rounded-2xl sm:rounded-3xl p-5 sm:p-6 shadow-xs hover:shadow-sm transition-shadow space-y-3 sm:space-y-4">
                <div class="flex items-center justify-between text-tutor-purple">
                    <div class="flex items-center gap-2">
                        <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-purple-100 flex items-center justify-center">
                            <span class="material-symbols-outlined text-base sm:text-lg">auto_awesome</span>
                        </div>
                        <h3 class="font-extrabold text-xs sm:text-sm tracking-tight text-purple-950">Tutor Pedagógico IA</h3>
                    </div>
                    <span class="text-[9px] sm:text-[10px] font-mono font-bold bg-purple-100 text-purple-800 px-2 py-0.5 rounded-full">Gemini 2.5</span>
                </div>

                <div class="space-y-1">
                    <span class="text-[10px] sm:text-[11px] font-bold text-purple-700 uppercase tracking-wider">Dica Didática</span>
                    <h4 class="font-bold text-xs sm:text-sm text-slate-900">Conversão de Unidades Superficiais</h4>
                </div>

                <p class="text-xs text-slate-600 leading-relaxed">
                    Atenção máxima: Ao converter medidas de área ($m^2$ para $cm^2$), eleve a razão linear ao quadrado:
                </p>

                <div class="bg-white p-3 rounded-xl sm:rounded-2xl border border-purple-100 font-mono-math text-[11px] sm:text-xs text-purple-900 space-y-1 shadow-2xs">
                    <div class="text-slate-500">1 m linear = 100 cm</div>
                    <div class="font-bold text-primary">(1 m)² = 10.000 cm²</div>
                    <div class="text-emerald-700 pt-0.5">3,5 m² = 35.000 cm²</div>
                </div>

                <div class="p-2.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-[10px] sm:text-[11px] flex items-start gap-1.5 sm:gap-2">
                    <span class="material-symbols-outlined text-[16px] text-amber-600 mt-0.5 shrink-0">warning</span>
                    <span>Nunca multiplique apenas por 100 em problemas de área!</span>
                </div>

                <a asp-controller="Home" asp-action="Simulado" class="w-full inline-flex items-center justify-center gap-1.5 py-2.5 px-4 rounded-xl bg-purple-100 hover:bg-purple-200 text-purple-900 text-xs font-bold transition-colors">
                    <span class="material-symbols-outlined text-[16px]">chat</span>
                    <span>Testar no Simulado</span>
                </a>
            </div>

            <!-- Formulas Reference Quick Cards -->
            <div class="bg-white border border-indigo-100 rounded-2xl sm:rounded-3xl p-5 sm:p-6 shadow-xs space-y-3 sm:space-y-4">
                <div class="flex items-center justify-between">
                    <h3 class="font-extrabold text-xs sm:text-sm text-slate-900 flex items-center gap-2">
                        <span class="material-symbols-outlined text-secondary text-base sm:text-lg">functions</span>
                        Formulário Rápido
                    </h3>
                    <span class="text-[9px] sm:text-[10px] font-mono font-bold text-slate-400">EUCLIDES</span>
                </div>

                <div class="space-y-2.5 sm:space-y-3">
                    <div class="p-3 rounded-xl sm:rounded-2xl bg-[#FAF8FF] border border-indigo-100/70 space-y-1">
                        <div class="flex items-center justify-between text-[11px] sm:text-xs text-slate-600 font-medium">
                            <span class="font-bold text-slate-800">Quadrado</span>
                            <span class="font-mono text-primary">Lado = L</span>
                        </div>
                        <div class="font-mono-math text-xs sm:text-sm font-bold text-primary">A = L² &bull; 2p = 4L</div>
                    </div>

                    <div class="p-3 rounded-xl sm:rounded-2xl bg-[#FAF8FF] border border-indigo-100/70 space-y-1">
                        <div class="flex items-center justify-between text-[11px] sm:text-xs text-slate-600 font-medium">
                            <span class="font-bold text-slate-800">Círculo</span>
                            <span class="font-mono text-primary">Raio = r</span>
                        </div>
                        <div class="font-mono-math text-xs sm:text-sm font-bold text-primary">C = 2·π·r &bull; A = π·r²</div>
                    </div>

                    <div class="p-3 rounded-xl sm:rounded-2xl bg-[#FAF8FF] border border-indigo-100/70 space-y-1">
                        <div class="flex items-center justify-between text-[11px] sm:text-xs text-slate-600 font-medium">
                            <span class="font-bold text-slate-800">Triângulos</span>
                            <span class="font-mono text-primary">Pitágoras</span>
                        </div>
                        <div class="font-mono-math text-xs sm:text-sm font-bold text-primary">c² = a² + b²</div>
                    </div>
                </div>

                <a asp-controller="Home" asp-action="Aulas" class="block text-center text-xs font-bold text-secondary hover:text-primary transition-colors pt-1">
                    Ver demonstrações completas &rarr;
                </a>
            </div>

        </div>

    </div>

</div>
